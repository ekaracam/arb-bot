# --- Tarama eşikleri ---------------------------------------------------------
# Bildirim için gereken minimum NET kar (yüzde). Tüm komisyon/çekim/gas düşülmüş.
MIN_NET_PCT=0.4
# L2 derinlik doğrulamasını tetikleyen ucuz ön-filtre eşiği.
#
# MIN_NET_PCT'in HEMEN ALTINDA tut. Ham fark her zaman net kârdan büyüktür
# (komisyon, çekim ücreti, gas ve kayma yalnızca eksiltir), dolayısıyla ham
# farkı MIN_NET_PCT'in altındaki bir aday matematiksel olarak sinyal
# ÜRETEMEZ — o bandı doğrulamak saf israftır. Aradaki küçük pay, Aşama 1 ile
# Aşama 2 arasında fiyatın lehe hareket etmesi ihtimali içindir.
#
# Ölçüldü: 0.15 iken saniyede ~960 aday üretiliyor, doğrulama kuyruğu (40)
# sürekli doluyor ve adayların çoğu hiç doğrulanmadan atılıyordu.
PREFILTER_PCT=0.3
# Fırsat hesabında varsayılan işlem büyüklüğü (USDT). Gerçekçi tut — büyük tutar
# derinliği tüketir ve VWAP kötüleşir, bu tam olarak görmek istediğimiz şey.
TRADE_SIZE_QUOTE=1000
# Tokenlaştırılmış hisse senetlerinin (xStocks / Backed Finance) CEX bacağı
# BAŞINA taşıdığı EK kesinti (yüzde). Borsanın taker komisyonuna EKLENİR;
# semboller config/hisse-tokenlari.json içinde ELLE tutulur.
#
# Neden ayrı bir kalem: ölçüldü, bu kesinti işlem komisyonu DEĞİL — Gate ve
# MEXC bu çiftlere normal çiftlerle birebir aynı taker oranını uyguluyor
# (%0.2 ve %0.05). Yani exchanges.json'daki komisyon doğru, buna rağmen
# gerçekleşen tutar eksik geliyor: Bybit'e Solana üzerinden yapılan
# transferde ~%1.5 kayıp ölçüldü.
#
# Mekanizma belgelenmemiş, yalnızca büyüklüğü ölçülü. Bu yüzden değer
# YÜKSEK tarafta tutulur: olduğundan düşük yazmak doğrudan sahte sinyal
# üretir, yüksek yazmak yalnızca fırsat kaçırır (komisyonların da kuralı bu).
# 0 yazmak kalemi tamamen kapatır.
HISSE_TOKEN_EK_PCT=1.5
# Bu yaştan eski fiyatlar fırsat üretmez (ms). CEX venue'ları için.
MAX_PRICE_AGE_MS=3000
# DEX venue'ları için ayrı eşik. DEX fiyatı push edilmez, HTTP ile çekilir ve
# periyodu kaynağın dakikalık limiti belirler (109 mint → 10 sn). CEX eşiğini
# DEX'e uygulamak her okumayı bayat sayar ve CEX↔DEX fırsatını yapısal olarak
# imkânsız kılar. DEX tarama periyodunun en az 2-3 katı olmalı.
MAX_DEX_PRICE_AGE_MS=30000
# Dirty pair değerlendirme periyodu (ms). Düşürmek CPU'yu artırır, gecikmeyi çok az azaltır.
EVAL_INTERVAL_MS=50
# Aynı çift bu süre içinde yeniden doğrulanmaz (Aşama 2 soğuması, ms).
#
# Değer L2 derinlik önbelleğinin TTL'ine (2 sn) BAĞLIDIR: daha sık doğrulamak
# aynı defteri okuyup aynı sonuca varır, yani bilgi üretmeden kuyruk ve
# rate-limit kotası yakar. "Uçuştaki aynı aday" koruması tek başına yetmiyordu
# — doğrulama biter bitmez aynı çift yeniden kuyruğa giriyordu.
#
# Yükseltirken dikkat: "kapanmayan fark" uyarısının epizot boşluğu bundan
# türetiliyor (max(5 × VERIFY_COOLDOWN_MS, 15 sn)).
VERIFY_COOLDOWN_MS=2000
# Çekim durumu doğrulanamayan borsalar (binance/bybit/okx/mexc) için sinyal üretilsin mi?
ALLOW_UNVERIFIED_TRANSFER=1

# --- Borsa API anahtarları (SALT-OKUNUR) -------------------------------------
# Tek kullanım yeri: çekim/yatırma durumunu doğrulamak. Bot v1'de emir GÖNDERMEZ.
# Anahtarları oluştururken YALNIZCA okuma yetkisi ver — çekim/işlem yetkisi VERME.
# Mümkünse IP kısıtlaması ekle.
#
# Anahtar girilmeyen borsa "doğrulanmamış" kalır ve sinyalleri `?` ile işaretlenir.
# Gate ve KuCoin public API'den zaten doğrulanıyor, anahtar gerektirmez.
#
# Not: KEY ve SECRET birlikte girilmeli; biri eksikse bot başlangıçta durur.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
MEXC_API_KEY=
MEXC_API_SECRET=
# OKX ayrıca passphrase ister (anahtarı oluştururken sen belirlersin).
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
# Gate DİĞERLERİNDEN FARKLI: çekim durumu ve kontrat adresi zaten public uçtan
# geliyor, yani anahtarsız da "doğrulanmış" sayılır. Anahtarın eklediği tek şey
# gerçek ÇEKİM ÜCRETİ — public uç bu alanı vermiyor ve yerine işlem
# büyüklüğünün sabit bir yüzdesi tahmin ediliyor. Ucuz coinlerde bu tahmin
# ciddi sapıyor (ölçüm: RWA için 769 coin tahmin, KuCoin'in gerçek ücreti 450),
# yani kâr hesabı doğrudan etkileniyor. Anahtar başarısız olursa gate
# doğrulanmış KALIR, yalnızca ücret tahmine geri döner.
GATE_API_KEY=
GATE_API_SECRET=
# Kraken'in public API'si zincir listesi/çekim durumu HİÇ vermiyor (ölçüldü:
# /0/public/Assets yalnızca status ve decimals döndürüyor), bu yüzden anahtarsız
# Kraken bacakları "doğrulanmadı" uyarısı taşır. Anahtar zincir listesini ve
# asgari çekim tutarını getirir; çekim ÜCRETİ ve kontrat adresi Kraken'de
# hiçbir uçtan alınamıyor, onlar tahmine düşmeye devam eder.
# Kraken'de anahtar oluştururken "Query Funds" + "Query Ledger" yeterli;
# para çekme (Withdraw Funds) izni VERME.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# --- Telegram ----------------------------------------------------------------
TELEGRAM_ENABLED=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Aynı fırsat için tekrar bildirim arası minimum süre (ms).
TELEGRAM_COOLDOWN_MS=300000
# Cooldown dolmadan tekrar göndermek için gereken net% değişimi.
TELEGRAM_RESEND_DELTA_PCT=0.5

# --- Zincir RPC --------------------------------------------------------------
# wss:// tercih et — blok event'iyle tetiklenmek için gerekli.
# Ücretsiz public RPC bu iş için yetersizdir (rate-limit + gecikme).
BASE_RPC_URL=
ARBITRUM_RPC_URL=
SOLANA_RPC_URL=
# Jupiter: boş bırakılırsa lite-api (ücretsiz, rate-limitli) kullanılır.
JUPITER_API_KEY=

# Solana Aşama 1 (geniş tarama) fiyat kaynağı: jupiter | geckoterminal
#
# Aşama 2 DOĞRULAMASI her zaman Jupiter'dir; bu ayar yalnızca hangi çiftin
# doğrulanacağını seçen ucuz taramayı etkiler.
#
# geckoterminal ücretsiz ve anahtarsızdır (30 istek/dk) ve Jupiter'in ücretsiz
# kovasını (1 istek/sn) tamamen doğrulamaya bırakır — 100+ token izlerken
# anahtarsız çalışmanın tek makul yolu budur. Ölçülen sapma: medyan %0.10,
# p90 %0.57. JUPITER_API_KEY aldığında jupiter'e geri dön.
SOLANA_PRICE_SOURCE=jupiter

# --- Sesli uyarı -------------------------------------------------------------
# Eşiği geçen YENİ bir fırsat bulununca bilgisayardan uyarı sesi çalar.
# Windows'ta 1 kHz'lik beep tonu, diğer platformlarda terminal zili kullanılır.
SOUND_ENABLED=1
# İki ses arası asgari süre (ms). Düşürmek, aynı anda birçok coin eşiği
# geçtiğinde sesi kesintisiz uğultuya çevirir.
SOUND_COOLDOWN_MS=15000

# --- Terminal UI -------------------------------------------------------------
UI_ENABLED=1
UI_REFRESH_HZ=4
UI_MAX_ROWS=15

# --- Kalıcı kayıt ------------------------------------------------------------
# Her fırsat NDJSON'a yazılır. Otomasyona geçmeden önce calibrate.ts ile
# bu kayıtlar üzerinden sahte-sinyal oranını ölçmek şart.
PERSIST_ENABLED=1
