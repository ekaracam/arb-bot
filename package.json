{
  "name": "arb-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/main.js --packages=external",
    "check": "tsc --noEmit",
    "test": "node --test --experimental-transform-types \"test/*.test.ts\"",
    "feeds": "tsx scripts/check-feeds.ts",
    "dex": "tsx scripts/check-dex.ts",
    "verify-contracts": "tsx scripts/verify-contracts.ts",
    "verify-keys": "tsx scripts/verify-keys.ts",
    "discover-tokens": "tsx scripts/discover-tokens.ts",
    "kapsam": "tsx scripts/kapsam.ts",
    "fiyatlar": "tsx scripts/fiyatlar.ts",
    "izle": "tsx scripts/izleme.ts",
    "calibrate": "tsx scripts/calibrate.ts"
  },
  "dependencies": {
    "protobufjs": "^7.4.0",
    "viem": "^2.21.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
